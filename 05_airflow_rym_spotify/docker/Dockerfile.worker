FROM python:3.11-slim
WORKDIR /workspace
ENV PYTHONPATH=/workspace PYTHONUNBUFFERED=1 MPLBACKEND=Agg
COPY requirements-worker.txt ./requirements-worker.txt
RUN pip install --no-cache-dir -r requirements-worker.txt
COPY src/ ./src/
COPY worker/ ./worker/
COPY data/ ./data/
RUN mkdir -p /workspace/resultados
CMD ["uvicorn", "worker.service:app", "--host", "0.0.0.0", "--port", "8000"]
